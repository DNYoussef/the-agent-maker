# Agent Forge V2 - Environment Configuration Template
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to git!

# =============================================================================
# GlobalMOO Configuration (Required for cloud MOO)
# =============================================================================
# Get your API key from: https://app.globalmoo.com
# SDK: pip install globalmoo-sdk
# Docs: https://globalmoo.gitbook.io/globalmoo-documentation
GLOBALMOO_API_KEY=your_api_key_here
GLOBALMOO_API_URL=https://app.globalmoo.com/api/

# =============================================================================
# Optional: WandB for experiment tracking
# =============================================================================
# WANDB_API_KEY=your_wandb_key_here
# WANDB_PROJECT=agent-forge-v2

# =============================================================================
# Optional: HuggingFace for model downloads
# =============================================================================
# HF_TOKEN=your_huggingface_token_here
